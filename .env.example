# --- Supabase (DB + Realtime + anon auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (photo storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yearbook-photos
R2_PUBLIC_BASE=https://your-bucket.r2.dev

# --- Liveblocks (collab realtime, optional) ---
LIVEBLOCKS_SECRET_KEY=

# Token used to enable admin mode via /?admin=<token>
ADMIN_TOKEN=change-me-in-prod

# Optional: override branding for this event
NEXT_PUBLIC_YEARBOOK_TITLE=Yearbook 2026
NEXT_PUBLIC_YEARBOOK_EMOJI=🎓

# Optional: signs upload tokens (if you bring back per-photo HMACs later)
YEARBOOK_TOKEN_SECRET=change-me-in-prod
